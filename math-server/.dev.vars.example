# 本地开发用密钥配置（复制为 .dev.vars 并填真值；.dev.vars 已被 gitignore）

# MySQL 连接串（后端启动时自动创建缺少的数据表）
DATABASE_URL=mysql://math_quiz_app:请替换为应用账号密码@127.0.0.1:3306/math_quiz

# JWT 签名密钥（长随机串）
JWT_SECRET=

# 管理口令（/admin 管理页重置用户密码用；不配置则管理接口关闭）
ADMIN_TOKEN=

# QQ 邮箱 SMTP（授权码，不是邮箱登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 微信小程序服务端配置（真实密钥仅放 .dev.vars，绝不放入小程序前端）
WECHAT_MINIPROGRAM_APPID=
WECHAT_MINIPROGRAM_APPSECRET=
