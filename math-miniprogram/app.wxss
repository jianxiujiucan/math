page {
  min-height: 100%;
  /* background: #b9ddf2; */
  background: #c2dcf0;
  background: url('data:image/png;base64,') no-repeat center top #c2dcf0;
  background-size: 30% auto;
  background-position: right 40rpx top 20rpx;
  color: #33475b;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 50rpx calc(132rpx + env(safe-area-inset-bottom));
}

.page.no-tabs {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.page-title {
  display: block;
  margin: 12rpx 0 28rpx;
  color: #33475b;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
  text-shadow: none;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 16rpx;
  background: #fffdf2;
  box-shadow: 0 12rpx 28rpx rgba(51, 71, 91, 0.13);
}

.primary-btn,
.secondary-btn {
  width: 100%;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.primary-btn {
  background: #f599b1;
  box-shadow: 0 8rpx 16rpx rgba(63, 115, 146, 0.24);
  color: #ffffff;
}

.secondary-btn {
  border: 2rpx solid #62aae7;
  background: #e8f5fb;
  color: #62aae7;
}

.primary-btn.button-hover,
.secondary-btn.button-hover {
  opacity: 0.88;
  transform: scale(0.98);
}

button[disabled] {
  opacity: 0.5;
}

.link-btn {
  display: inline;
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #62aae7;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin: 0 0 12rpx;
  color: #33475b;
  font-size: 26rpx;
  font-weight: 600;
}

.text-input {
  width: 100%;
  height: 84rpx;
  padding: 0 28rpx;
  border: 2rpx solid #d8e7ef;
  border-radius: 24rpx;
  background: #ffffff;
  color: #33475b;
  font-size: 30rpx;
}

.input-error {
  border-color: #e74c3c;
}

.form-error,
.form-success {
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.form-error {
  border: 1rpx solid #ffccc7;
  background: #fff2f0;
  color: #d94235;
}

.form-success {
  border: 1rpx solid #b7eb8f;
  background: #f0fff4;
  color: #23884b;
}

.state-text,
.loading-text {
  display: block;
  padding: 28rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.loading-text {
  color: #527087;
}

.card-title {
  margin-bottom: 16rpx;
  color: #33475b;
  font-size: 28rpx;
  font-weight: 700;
}

.muted {
  color: #999999;
}
