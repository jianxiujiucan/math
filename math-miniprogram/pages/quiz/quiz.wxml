<view wx:if="{{ready}}" class="page quiz-page {{finished ? 'is-finished' : ''}}">
  <view class="quiz-topbar">
  </view>

  <view class="quiz-header">
    <text class="badge">{{progress}}</text>
    <view class="badge timer-badge">
      <image class="timer-icon" src="/assets/img/icon/timer.svg" mode="aspectFit" />
      <text>{{timer}}</text>
    </view>
  </view>

  <view class="card question-card">
    <view class="question-meta"><text class="question-type">{{quizMeta}}</text><sound-toggle /></view>

    <text class="decor-plus" aria-hidden="true">+</text>
    <text class="decor-number" aria-hidden="true">8</text>
    <view class="question-line">
      <text class="question-text">{{expr}}</text>
      <view class="answer-input {{answered ? 'answered' : ''}}">{{answer || '?'}}</view>
      <text class="result-icon {{answered && lastRight ? 'right' : (wrong && !answered ? 'wrong' : '')}}">{{answered && lastRight ? '✓' : (wrong ? '✗' : '')}}</text>
    </view>
    <view wx:if="{{!answered && !wrong}}" class="question-hint">看清运算符号，再输入答案</view>
    <view wx:if="{{answered && lastRight}}" class="correct-feedback">回答正确</view>
    <view wx:if="{{wrong && !answered}}" class="feedback">答案错误，再想想</view>
  </view>

  <view wx:if="{{!finished}}" class="quiz-progress-track"><view style="width: {{progressPercent}}%"></view></view>

  <view wx:if="{{finished}}" class="card result-area">
    <view class="result-title">本次得分</view>
    <view class="score-text">{{score}} 分</view>
    <view class="cheer-text">{{cheer}}</view>
    <view class="summary-text">{{summary}}</view>
    <view class="save-tip">
      <block wx:if="{{saveState === 'saved'}}">
        <text class="saved-text">成绩已保存 ✓ </text>
        <button class="link-btn" bindtap="viewProfile">查看个人中心</button>
      </block>
      <text wx:elif="{{saveState === 'saving'}}">成绩保存中…</text>
      <block wx:elif="{{saveState === 'failed'}}">
        <text>成绩保存失败 </text><button class="link-btn" bindtap="saveResult">重试</button>
      </block>
      <button wx:else class="link-btn" bindtap="loginToSave">登录后可保存成绩</button>
    </view>
    <button class="primary-btn" hover-class="button-hover" bindtap="goHome">返回首页</button>
  </view>


  <numeric-keypad wx:if="{{!finished}}" disabled="{{answered}}" confirm-disabled="{{!answer}}" bind:digit="appendDigit" bind:backspace="eraseDigit" bind:confirm="tryCheck" />
</view>
