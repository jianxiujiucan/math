.user-card {
  position: relative;
  align-items: center;
  padding-top: 38rpx;
}

button.logout-btn {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.logout-icon {
  width: 48rpx;
  height: 48rpx;
}

.username-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
}

.username {
  margin-bottom: 8rpx;
  color: #333333;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

button.nickname-edit-btn {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0 0 8rpx;
  padding: 0;
  background: transparent;
  line-height: 1;
}

button.nickname-edit-btn.button-hover {
  background: #e8f5fb;
}

.nickname-edit-icon {
  width: 28rpx;
  height: 28rpx;
}

.nickname-edit-form {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 72rpx;
  margin-bottom: 8rpx;
}

.nickname-input {
  width: 360rpx;
  max-width: 55vw;
  height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid #d8e7ef;
  border-radius: 32rpx;
  background: #ffffff;
  color: #33475b;
  font-size: 28rpx;
}

.nickname-input.input-error {
  border-color: #e74c3c;
}

button.nickname-confirm-btn {
  flex: none;
  width: 120rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #62aae7;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
}

.nickname-error {
  margin: -2rpx auto 8rpx;
  color: #e74c3c;
  font-size: 22rpx;
  line-height: 1.5;

}

.user-meta {
  color: #999999;
  font-size: 23rpx;
  line-height: 1.7;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 28rpx;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  color: #ff6b6b;
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  color: #999999;
  font-size: 23rpx;
}

.type-row {
  display: grid;
  grid-template-columns: 1.35fr 0.65fr 1.45fr 0.75fr;
  align-items: center;
  min-height: 62rpx;
  border-bottom: 1rpx solid #f0f0f4;
  color: #555555;
  font-size: 22rpx;
  text-align: center;
}

.type-row text:first-child {
  text-align: left;
}

.type-head {
  color: #999999;
  font-size: 20rpx;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #efeff4;
}

.record-hover {
  background: #f7f8fc;
}

.record-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 6rpx;
}

.record-config {
  color: #333333;
  font-size: 26rpx;
  font-weight: 600;
}

.record-time {
  color: #999999;
  font-size: 22rpx;
}

.record-result {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-score {
  color: #ff6b6b;
  font-size: 30rpx;
  font-weight: 800;
}

.record-detail {
  color: #b0b0bd;
  font-size: 38rpx;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 22rpx;
  color: #999999;
  font-size: 24rpx;
}
