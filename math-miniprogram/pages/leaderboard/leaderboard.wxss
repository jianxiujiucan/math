.rule {
  margin: -8rpx 0 20rpx;
  color: #999999;
  font-size: 23rpx;
  line-height: 1.55;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid #efeff4;
}

.rank-row:last-child {
  border-bottom: 0;
}

.rank-badge {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #c9d4e5;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.rank-badge.r1 {
  background: #e5a829;
}

.rank-badge.r2 {
  background: #91a5b8;
}

.rank-badge.r3 {
  background: #c68b6d;
}

.rank-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}

.rank-name {
  overflow: hidden;
  color: #333333;
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-meta {
  color: #999999;
  font-size: 22rpx;
}

.rank-time {
  flex-shrink: 0;
  color: #62aae7;
  font-size: 25rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
