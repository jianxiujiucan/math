<view class="page no-tabs">
  <text class="page-title">找回密码</text>
  <view class="card forgot-card">
    <block wx:if="{{step === 'done'}}">
      <view class="success-icon">✓</view>
      <view class="success-title">密码重置成功</view>
      <view class="desc sub">请使用新密码登录你的账号。</view>
      <button class="primary-btn" bindtap="back">返回登录</button>
    </block>

    <block wx:else>
      <view class="desc">通过注册邮箱接收 6 位验证码，验证后即可设置新密码。</view>
      <view wx:if="{{errorMsg}}" class="form-error">{{errorMsg}}</view>
      <view wx:if="{{successMsg}}" class="form-success">{{successMsg}}</view>

      <form wx:if="{{step === 'email'}}" bindsubmit="sendCode">
        <view class="form-item">
          <text class="form-label">注册邮箱</text>
          <input class="text-input" type="text" value="{{email}}" placeholder="请输入注册时使用的邮箱" data-field="email" bindinput="onInput" />
        </view>
        <button class="primary-btn" form-type="submit" loading="{{loading}}" disabled="{{loading}}">{{loading ? '发送中…' : '发送验证码'}}</button>
      </form>

      <form wx:else bindsubmit="resetPassword">
        <view class="form-item">
          <text class="form-label">注册邮箱</text>
          <input class="text-input" value="{{email}}" disabled />
        </view>
        <view class="form-item">
          <text class="form-label">邮箱验证码</text>
          <input class="text-input code-input" type="number" value="{{code}}" maxlength="6" placeholder="请输入 6 位数字验证码" data-field="code" bindinput="onInput" />
        </view>
        <view class="form-item">
          <text class="form-label">新密码</text>
          <input class="text-input" password value="{{newPassword}}" placeholder="8 位以上，字母+数字组合" data-field="newPassword" bindinput="onInput" />
        </view>
        <view class="form-item">
          <text class="form-label">确认新密码</text>
          <input class="text-input" password value="{{confirm}}" placeholder="请再次输入新密码" data-field="confirm" bindinput="onInput" />
        </view>
        <button class="primary-btn" form-type="submit" loading="{{loading}}" disabled="{{loading}}">{{loading ? '提交中…' : '重置密码'}}</button>
        <view class="resend-row"><button class="link-btn" disabled="{{cooldown > 0 || loading}}" bindtap="sendCode">{{cooldown > 0 ? cooldown + ' 秒后可重发' : '重新发送验证码'}}</button></view>
      </form>

      <view class="back-row"><button class="link-btn" bindtap="back">返回登录</button></view>
      <view class="admin-row"><button class="link-btn" bindtap="openAdmin">管理员重置密码</button></view>
    </block>
  </view>
</view>
