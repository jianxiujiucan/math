.forgot-card {
  text-align: center;
}

.desc {
  margin-bottom: 28rpx;
  color: #527087;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: left;
}

.desc.sub {
  color: #8c9aa7;
  text-align: center;
}

.form-item {
  text-align: left;
}

.code-input {
  font-family: Arial, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  text-align: center;
}

.resend-row,
.back-row,
.admin-row {
  margin-top: 26rpx;
}

.admin-row .link-btn {
  color: #8c9aa7;
  font-size: 22rpx;
}

.success-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #e5f5ed;
  color: #5ba68a;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 104rpx;
}

.success-title {
  margin-bottom: 14rpx;
  color: #33475b;
  font-size: 36rpx;
  font-weight: 700;
}

.form-success {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #b7dfc8;
  border-radius: 12rpx;
  background: #f0fff4;
  color: #23884b;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}
