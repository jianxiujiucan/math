.option-group {
  margin-bottom: 28rpx;
}

.option-label {
  margin-bottom: 16rpx;
  color: #33475b;
  font-size: 24rpx;
  font-weight: 700;
}

.pill-group {
  display: grid;
  gap: 14rpx;
}

.pill-group.count-4 {
  grid-template-columns: repeat(4, 1fr);
}

.pill-group.count-6,
.pill-group.count-3 {
  grid-template-columns: repeat(3, 1fr);
}

.pill-group.count-2 {
  grid-template-columns: repeat(2, 1fr);
}

.pill {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 0;
  margin: 0;
  width: 100%;
  padding: 12rpx 6rpx;
  border: 2rpx solid #d8e7ef;
  border-radius: 40rpx;
  background: #ffffff;
  color: #527087;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.5;
}

button:not([size=mini]) {
  width: unset !important;
}

.pill::after {
  border: 0;
}

.pill.active {
  border-color: #62aae7;
  background: #62aae7;
  color: #ffffff;

}

.pill-hover {
  opacity: 0.82;
  transform: scale(0.97);
}

.pill[disabled] {
  opacity: 0.4;
}
