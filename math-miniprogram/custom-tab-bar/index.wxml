<view wx:if="{{loggedIn}}" class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="path"
    class="tab {{selected === index ? 'active' : ''}}"
    data-path="{{item.path}}"
    aria-label="{{item.label}}"
    bindtap="onSwitch"
  >
    <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
  </view>
</view>
