.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ececf2;
  background: #fffdf2;
  box-shadow: 0 -4rpx 20rpx rgba(40, 30, 80, 0.08);
}

.tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
}

.tab-icon {
  box-sizing: content-box;
  width: 44rpx;
  height: 44rpx;
  padding: 8rpx;
  border-radius: 50%;
  opacity: 0.45;
}

.tab.active .tab-icon {
  background: #e8f5fb;
  opacity: 1;
}
